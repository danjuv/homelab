module(name = "homelab")

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_apko", version = "1.5.56")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# --- images/opencode ---------------------------------------------------------

apko = use_extension("@rules_apko//apko:extensions.bzl", "apko")
apko.translate_lock(
    name = "opencode_base",
    lock = "//images/opencode:apko.lock.json",
)
use_repo(apko, "opencode_base")

# renovate: datasource=github-releases depName=anomalyco/opencode
OPENCODE_VERSION = "2.2.2"

# Version is literal in the URL so Renovate's bazel manager updates it and recomputes the sha256.
http_archive(
    name = "opencode_bin",
    build_file_content = 'exports_files(["opencode"])',
    sha256 = "31c9dd2e77ac080aa6b9b6a06785fcfba5cfa795644ced62e88841f2b90c6dc0",
    urls = ["https://github.com/anomalyco/opencode/releases/download/v2.2.2/opencode-linux-x64-baseline.tar.gz"],
)

# Not packaged in Wolfi.
# renovate: datasource=github-releases depName=yannh/kubeconform
KUBECONFORM_VERSION = "0.8.0"

# Version is literal in the URL so Renovate's bazel manager updates it and recomputes the sha256.
http_archive(
    name = "kubeconform_bin",
    build_file_content = 'exports_files(["kubeconform"])',
    sha256 = "9bc2bffbf71f261128533edaf912153948b7ff238f9a531ae6d34466ec287883",
    urls = ["https://github.com/yannh/kubeconform/releases/download/v0.8.0/kubeconform-linux-amd64.tar.gz"],
)
