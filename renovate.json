{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/k8s/argocd/apps/.+\\.yaml$/"
    ]
  },
  "kustomize": {
    "managerFilePatterns": [
      "/k8s/admin/metallb/kustomization\\.yaml$/",
      "/k8s/apps/grimmory/kustomization\\.yaml$/",
      "/k8s/apps/hindsight/kustomization\\.yaml$/"
    ]
  },
  "bazel": {
    "managerFilePatterns": [
      "/(^|/)WORKSPACE(|\\.bazel|\\.bzlmod)$/",
      "/\\.WORKSPACE\\.bazel$/",
      "/\\.bzl$/",
      "/(^|/)MODULE\\.bazel$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/k8s/apps/.+/values\\.yaml$/"],
      "matchStrings": [
        "repository:\\s*(?<depName>\\S+)\\s*\\n\\s*tag:\\s*[\"']?(?<currentValue>\\S+?)[\"']?\\s*\\n\\s*digest:\\s*(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/k8s/apps/.+/values\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*[\\w.-]+:\\s*[\"']?(?<currentValue>[^\\s\"']+)"
      ],
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)MODULE\\.bazel$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s*\\n\\s*[A-Za-z0-9_]+\\s*=\\s*[\"'](?<currentValue>[^\"']+)[\"']"
      ],
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/k8s/apps/opencode/.+\\.yaml$/"],
      "matchStrings": [
        "image:\\s*(?:&\\w+\\s+)?(?<depName>[^\\s\"'@]+):(?<currentValue>[^@\\s\"']+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["argocd"],
      "matchDepNames": ["ghcr.io/bjw-s-labs/helm/app-template/app-template"],
      "overridePackageName": "bjw-s-labs/helm/app-template",
      "registryUrls": ["https://ghcr.io"]
    },
    {
      "matchManagers": ["argocd"],
      "matchDepNames": ["ghcr.io/seerr-team/seerr/seerr-chart/seerr-chart"],
      "overridePackageName": "seerr-team/seerr/seerr-chart",
      "registryUrls": ["https://ghcr.io"]
    },
    {
      "matchManagers": ["argocd"],
      "matchDepNames": ["oci.trueforge.org/truecharts/tautulli/tautulli"],
      "overridePackageName": "truecharts/tautulli",
      "registryUrls": ["https://oci.trueforge.org"]
    },
    {
      "matchManagers": ["argocd"],
      "matchDepNames": ["quay.io/jetstack/charts/cert-manager/cert-manager"],
      "overridePackageName": "jetstack/charts/cert-manager",
      "registryUrls": ["https://quay.io"]
    },
    {
      "matchManagers": ["argocd"],
      "matchDepNames": ["ghcr.io/vectorize-io/charts/hindsight/hindsight"],
      "overridePackageName": "vectorize-io/charts/hindsight",
      "registryUrls": ["https://ghcr.io"]
    },
    {
      "matchDepNames": ["ghcr.io/grimmory-tools/helm-charts/grimmory"],
      "overridePackageName": "grimmory-tools/helm-charts/grimmory",
      "registryUrls": ["https://ghcr.io"]
    },
    {
      "matchManagers": ["argocd"],
      "matchDepNames": ["ghcr.io/containers/charts/kubernetes-mcp-server/kubernetes-mcp-server"],
      "overridePackageName": "containers/charts/kubernetes-mcp-server",
      "registryUrls": ["https://ghcr.io"]
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/danjuv/opencode"],
      "versioning": "semver",
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "matchPackageNames": ["anomalyco/opencode"],
      "groupName": "opencode",
      "allowedVersions": "/^v?\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "matchPackageNames": ["yannh/kubeconform"],
      "groupName": "kubeconform",
      "allowedVersions": "/^v?\\d+\\.\\d+\\.\\d+$/"
    },
    {
      "matchPackageNames": ["qbittorrentofficial/qbittorrent-nox"],
      "allowedVersions": "/^5\\.2\\.\\d+-lt2-\\d+$/"
    },
    {
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ]
}
