{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/k8s/argocd/apps/.+\\.yaml$/"
    ]
  },
  "kustomize": {
    "managerFilePatterns": [
      "/k8s/admin/metallb/kustomization\\.yaml$/"
    ]
  },
  "packageRules": [
    {
      "matchManagers": ["argocd"],
      "matchDepNames": ["ghcr.io/seerr-team/seerr/seerr-chart/seerr-chart"],
      "packageName": "seerr-team/seerr/seerr-chart",
      "registryUrls": ["https://ghcr.io"]
    }
  ]
}
