{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "argocd": {
    "fileMatch": ["k8s/argocd/apps/.+\\.yaml$"]
  },
  "kustomize": {
    "fileMatch": ["k8s/admin/metallb/kustomization\\.yaml$"]
  },
  "packageRules": [
    {
      "matchManagers": ["argocd"],
      "matchDepNames": ["seerr-chart"],
      "registryUrls": ["https://ghcr.io"],
      "packageName": "seerr-team/seerr/seerr-chart"
    }
  ]
}
